# sprintctl runs in served mode against the Vuoro work adapter (backfilled
# into vuoro-shared 2026-07-24 -- see sprintctl
# docs/plans/1164-gate-evidence-ledger.md). Direct PostgreSQL credentials
# are no longer the default path; set SPRINTCTL_BACKEND=remote in
# .env.sprintctl.local (still sourced below) to roll back. Tenant isolation
# is by repo_id ("scribectl") recorded in .sprintctl/backend.json.
export SPRINTCTL_BACKEND=served
export SPRINTCTL_VUORO_PROFILE=/projects/dev/agentops/templates/dispatch/environment-record/profiles/workstation-vuoro-shared.json

_envrc_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "${_envrc_dir}/.env.sprintctl.local" ]; then
  # shellcheck disable=SC1091
  . "${_envrc_dir}/.env.sprintctl.local"
fi
unset _envrc_dir

if [ "${SPRINTCTL_BACKEND:-}" = "remote" ]; then
  export SPRINTCTL_URL="${SPRINTCTL_URL:?Set SPRINTCTL_URL from an injected secret or .env.sprintctl.local before entering this repo}"
fi

# auditctl sidecar (same wiring as homelab-analytics)
export AUDITCTL_DB="${PWD}/.auditctl/auditctl.db"
export AUDITCTL_ARTIFACTS_ROOT="/projects/dev"
