# sprintctl normal work is served by the Vuoro work adapter. Tenant isolation
# is by repo_id ("scribectl") recorded in .sprintctl/backend.json.
export SPRINTCTL_BACKEND=served
export SPRINTCTL_VUORO_PROFILE=/projects/dev/agentops/templates/dispatch/environment-record/profiles/workstation-vuoro-shared.json
unset SPRINTCTL_URL

# auditctl sidecar (same wiring as homelab-analytics)
export AUDITCTL_DB="${PWD}/.auditctl/auditctl.db"
# Evidence is rooted at this repository, not the workspace. Shards land under
# ./_artifacts/<scope>/ and are committed, so git replicates them wherever it
# replicates the code they describe. /projects/dev/_artifacts is in no git
# repository and AGENTS.md classifies it semi-ephemeral and host-local.
# See agentops docs/plans/agentops/operative-position-durability-2026-08-29.md.
export AUDITCTL_ARTIFACTS_ROOT="${PWD}"
